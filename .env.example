# Hint only — runtime picks production automatically on HTTPS + geekhost.com.br
# Local / XAMPP / php -S always use sandbox (unless ASAAS_ALLOW_PROD_LOCAL=1).
ASAAS_ENV=sandbox
ASAAS_ALLOW_PROD_LOCAL=0

ASAAS_SANDBOX_URL=https://api-sandbox.asaas.com/v3
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=

ASAAS_PRODUCTION_URL=https://api.asaas.com/v3
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=

# sqlite (agent/dev) or mysql (XAMPP / DirectAdmin)
DB_DRIVER=mysql
DB_PATH=storage/geekhost.sqlite

# MySQL — XAMPP local: root / empty password
# Production DirectAdmin example user: geek6923_banco (set password only on the server .env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geekhost
DB_USER=root
DB_PASS=

# Leave empty to auto-detect from the request (works for php -S AND XAMPP junction).
# Optional absolute site URL for emails/webhooks only:
GEEKHOST_PUBLIC_URL=
# Optional override only for CLI; HTTP requests ignore this and auto-detect:
GEEKHOST_BASE_PATH=
GEEKHOST_CONTACT_EMAIL=contato@geekhost.com.br
GEEKHOST_WHATSAPP=5516997399174
# Comma-separated staff emails that can access /painel/admin/tickets
GEEKHOST_ADMIN_EMAILS=diretoria@geekhost.com.br

# 32+ char secret for encrypting PII at rest
APP_DATA_KEY=

# DirectAdmin (reseller) — never expose to frontend. Values only in server .env.
DIRECTADMIN_URL=https://br74-da.valueserver.net.br:2222
DIRECTADMIN_USERNAME=
# Login key is used as the Basic Auth password (DA login-key auth).
DIRECTADMIN_LOGIN_KEY=
# Optional account password fallback if LOGIN_KEY is empty.
DIRECTADMIN_PASSWORD=
# Mutating ops (create/suspend/ssl/wp) stay off until explicitly enabled.
DIRECTADMIN_PROVISIONING_ENABLED=false
DIRECTADMIN_DRY_RUN=0
DIRECTADMIN_VERIFY_SSL=1
DIRECTADMIN_TIMEOUT=30
# Map GeekHost plans → DA reseller package names (ValueServer)
DIRECTADMIN_PACKAGE_LIGHT=Plano-Light-GeekHost
DIRECTADMIN_PACKAGE_EMPRESA=Plano-Empresa-GeekHost
DIRECTADMIN_PACKAGE_PREMIUM=Plano-Premium-GeekHost
DIRECTADMIN_PACKAGE_DEFAULT=Plano-Light-GeekHost
# Only set if GeekHost really serves provisional DNS for {user}.suffix
DIRECTADMIN_PROVISIONAL_DOMAIN_SUFFIX=
DIRECTADMIN_PROVISIONAL_DNS_READY=0
# Shared secret for /cron/hosting.php?token=
CRON_HOSTING_TOKEN=

