ASAAS_ENV=sandbox

ASAAS_SANDBOX_URL=https://api-sandbox.asaas.com/v3
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=

ASAAS_PRODUCTION_URL=https://api.asaas.com/v3
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=

# sqlite (local) or mysql (DirectAdmin)
DB_DRIVER=sqlite
DB_PATH=storage/geekhost.sqlite

# MySQL (DirectAdmin) — used when DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geekhost
DB_USER=
DB_PASS=

GEEKHOST_PUBLIC_URL=https://geekhost.com.br
GEEKHOST_CONTACT_EMAIL=contato@geekhost.com.br
GEEKHOST_WHATSAPP=5516997399174

APP_DATA_KEY=

