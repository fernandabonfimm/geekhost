Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP does not always receive Authorization. Keep the bearer token available.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # If the browser typed /public_html, send it to the same path without that folder.
    # Internal rewrites already set REDIRECT_STATUS, so this does not loop.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/geekhost/public_html/?(.*)$
    RewriteRule ^ /geekhost/%1 [R=301,L]

    RewriteRule ^checkout/?$ checkout.php [L,QSA]
    RewriteRule ^api/checkout/create/?$ api/checkout/create.php [L,QSA]
    RewriteRule ^api/checkout/status/?$ api/checkout/status.php [L,QSA]
    RewriteRule ^api/webhooks/asaas/?$ api/webhooks/asaas.php [L,QSA]

    # Old bookmarks: client lived at /painel and admin at /admin.
    # REQUEST_URI is the browser URL, so the new /painel (admin) is not redirected.
    RewriteCond %{REQUEST_URI} ^/geekhost/painel/?(.*)$
    RewriteRule ^painel/?(.*)$ /portal/%1 [R=301,L]
    RewriteCond %{REQUEST_URI} ^/geekhost/admin/?(.*)$ [OR]
    RewriteCond %{REQUEST_URI} ^/admin/?(.*)$
    RewriteRule ^admin/?(.*)$ /painel/$1 [R=301,L]

    RewriteRule ^cron/billing/?$ cron/billing.php [L,QSA]

    # Admin is public /painel → files in admin/
    RewriteRule ^painel/?$ admin/index.php [L,QSA]
    RewriteRule ^painel/([a-z0-9-]+)/?$ admin/$1.php [L,QSA]

    # Client is public /portal → files in painel/
    RewriteRule ^portal/?$ painel/index.php [L,QSA]
    RewriteRule ^portal/admin/tickets/?$ painel/admin/tickets.php [L,QSA]
    RewriteRule ^portal/([a-z0-9-]+)/?$ painel/$1.php [L,QSA]

    # Client API /api/portal → api/painel. Admin API /api/painel → api/admin.
    RewriteRule ^api/portal/([a-z0-9-]+)/?$ api/painel/$1.php [L,QSA]
    RewriteRule ^api/painel/([a-z0-9-]+)/?$ api/admin/$1.php [L,QSA]

    # Extensionless .php fallback (covers future admin/painel pages)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
