Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP does not always receive Authorization. Keep the bearer token available.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # If the browser typed /public_html, send it to the same path without that folder.
    # Internal rewrites already set REDIRECT_STATUS, so this does not loop.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/geekhost/public_html/?(.*)$
    RewriteRule ^ /geekhost/%1 [R=301,L]

    RewriteRule ^base-de-conhecimento/?$ base-de-conhecimento.php [L,QSA]
    RewriteRule ^base-de-conhecimento/([a-z0-9-]+)/?$ base-de-conhecimento.php?slug=$1 [L,QSA]
    RewriteRule ^checkout/?$ checkout.php [L,QSA]
    RewriteRule ^api/checkout/create/?$ api/checkout/create.php [L,QSA]
    RewriteRule ^api/checkout/status/?$ api/checkout/status.php [L,QSA]
    RewriteRule ^api/webhooks/asaas/?$ api/webhooks/asaas.php [L,QSA]
    RewriteRule ^cron/billing/?$ cron/billing.php [L,QSA]

    # Undo mistaken /portal remap bookmarks → client /painel (never /admin → /painel).
    RewriteRule ^portal/?(.*)$ /painel/$1 [R=301,L]
    RewriteRule ^api/portal/([a-z0-9-]+)/?$ /api/painel/$1 [R=301,L]

    # Admin ops: /admin → admin/
    RewriteRule ^admin/?$ admin/index.php [L,QSA]
    RewriteRule ^admin/([a-z0-9-]+)/?$ admin/$1.php [L,QSA]

    # Client panel: /painel → painel/
    RewriteRule ^painel/?$ painel/index.php [L,QSA]
    RewriteRule ^painel/admin/tickets/?$ painel/admin/tickets.php [L,QSA]
    RewriteRule ^painel/([a-z0-9-]+)/?$ painel/$1.php [L,QSA]

    # APIs match folders 1:1
    RewriteRule ^api/admin/([a-z0-9-]+)/?$ api/admin/$1.php [L,QSA]
    RewriteRule ^api/painel/([a-z0-9-]+)/?$ api/painel/$1.php [L,QSA]

    # Extensionless .php fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
