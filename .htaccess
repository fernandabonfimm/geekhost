Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Old local URLs: /geekhost/admin → /painel, /geekhost/painel (client) → /portal.
    RewriteRule ^admin/?(.*)$ /painel/$1 [R=301,L]
    RewriteRule ^painel/?(.*)$ /portal/$1 [R=301,L]

    # Everything else is served from public_html without changing the address bar.
    RewriteCond %{REQUEST_URI} !/public_html/
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
